{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.js" }, { "source": "/(.*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/cron/morning", "schedule": "30 3 * * *" },
    { "path": "/api/cron/afternoon", "schedule": "30 6 * * *" },
    { "path": "/api/cron/evening", "schedule": "30 11 * * *" }
  ]
}
